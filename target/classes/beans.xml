<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Define Restaurant bean -->
    <bean id="restaurant" class="com.example.onliner.Restaurant">
        <constructor-arg value="Mayura"/>
        <constructor-arg value="kadapa"/>
        <constructor-arg value="italian"/>
          
    </bean>

    <!-- Define Customer bean -->
    <bean id="customer" class="com.example.online.Customer">
        <constructor-arg value="Vishnu"/>
        <constructor-arg value="78672672"/>
        <constructor-arg value="italian"/>
    </bean>

    <!-- Define FoodOrderService bean -->
    <bean id="foodOrderService" class="com.example.online.FoodOrderingservice">
        <constructor-arg ref="customer"/>
        <constructor-arg ref="restaurant"/>
    </bean>

</beans>